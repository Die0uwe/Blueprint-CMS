{% extends 'layout.twig' %}
{% block content %}
<div class="cf-page-header">
  <div class="cf-breadcrumb"><a href="/">Home</a> → <a href="/blog">Blog</a> → {{ post ? 'Bewerken' : 'Nieuwe post' }}</div>
  <h1>{{ post ? '✏️ Post bewerken' : '➕ Nieuwe blogpost' }}</h1>
</div>

<div class="cf-card">
  <div class="cf-card-body">
    <form method="post" action="{{ post ? '/blog/' ~ username ~ '/' ~ post.slug ~ '/bewerk' : '/blog/' ~ username ~ '/nieuw' }}">
      {{ csrf_field()|raw }}
      <div class="cf-form-group">
        <label class="cf-label" for="title">Titel</label>
        <input type="text" id="title" name="title" class="cf-input" maxlength="300" value="{{ post.title|default('') }}" required>
      </div>
      <div class="cf-form-group">
        <label class="cf-label" for="summary">Samenvatting (optioneel)</label>
        <input type="text" id="summary" name="summary" class="cf-input" maxlength="300" value="{{ post.summary|default('') }}">
      </div>
      <div class="cf-form-group">
        <label class="cf-label" for="content">Inhoud</label>
        <textarea id="content" name="content" class="cf-textarea" data-editor="richtext" style="min-height:280px;" required>{{ post.content|default('') }}</textarea>
      </div>
      <div class="cf-form-group">
        <label class="cf-label">
          <input type="radio" name="status" value="draft" {{ (post is null or post.status == 'draft') ? 'checked' : '' }}> Concept (alleen voor jou)
        </label>
        <label class="cf-label">
          <input type="radio" name="status" value="published" {{ (post and post.status == 'published') ? 'checked' : '' }}> Gepubliceerd
        </label>
      </div>
      <button type="submit" class="cf-btn">Opslaan</button>
      <a href="/blog/{{ username }}" class="cf-btn cf-btn-ghost">Annuleren</a>
    </form>
  </div>
</div>
{% endblock %}

{% block scripts %}{{ editor_assets() }}{% endblock %}
