{% extends 'layout.twig' %}
{% block content %}
<div style="max-width:420px;margin:3rem auto;">
  <div class="cf-card">
    <div class="cf-card-header">🔑 {{ trans('auth.forgot.title') }}</div>
    <div class="cf-card-body">
      {% if sent is defined and sent %}
        <div class="cf-alert cf-alert-success">{{ trans('auth.forgot.sent') }}</div>
        <p style="text-align:center;margin-top:1rem;font-size:.85rem;"><a href="/login">{{ trans('auth.forgot.back_to_login') }}</a></p>
      {% else %}
        {% if error is defined %}<div class="cf-alert cf-alert-error">{{ error }}</div>{% endif %}
        <p style="color:var(--muted);font-size:.9rem;margin-top:0;">{{ trans('auth.forgot.intro') }}</p>
        <form method="POST" action="/wachtwoord-vergeten">
          {{ csrf_field()|raw }}
          <div class="cf-form-group">
            <label class="cf-label">{{ trans('auth.login.identifier_label') }}</label>
            <input class="cf-input" type="text" name="identifier" required autofocus autocomplete="username" maxlength="255">
          </div>
          <button type="submit" class="cf-btn" style="width:100%;justify-content:center;">{{ trans('auth.forgot.submit') }}</button>
        </form>
        <p style="text-align:center;margin-top:1rem;font-size:.85rem;"><a href="/login">{{ trans('auth.forgot.back_to_login') }}</a></p>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
