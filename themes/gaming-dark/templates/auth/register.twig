{% extends 'layout.twig' %}
{% block content %}
<div style="max-width:480px;margin:3rem auto;">
  <div class="cf-card">
    <div class="cf-card-header">✨ {{ trans('auth.register.title') }}</div>
    <div class="cf-card-body">
      {% if errors is defined %}
        <div class="cf-alert cf-alert-error">{% for e in errors %}<div>{{ e }}</div>{% endfor %}</div>
      {% endif %}
      <form method="POST" action="/register">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.register.username_label') }}</label>
          <input class="cf-input" type="text" name="username" required>
        </div>
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.register.email_label') }}</label>
          <input class="cf-input" type="email" name="email" required>
        </div>
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.register.password_label') }}</label>
          <input class="cf-input" type="password" name="password" minlength="8" required>
        </div>
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.register.password_confirm_label') }}</label>
          <input class="cf-input" type="password" name="password_confirm" required>
        </div>
        <button type="submit" class="cf-btn" style="width:100%;justify-content:center;">{{ trans('auth.register.submit') }}</button>
      </form>
      {% include 'auth/_oauth_buttons.twig' %}

      <p style="text-align:center;margin-top:1rem;font-size:.85rem;color:var(--muted);">
        {{ trans('auth.register.have_account') }} <a href="/login">{{ trans('auth.register.login_link') }}</a>
      </p>
    </div>
  </div>
</div>
{% endblock %}
