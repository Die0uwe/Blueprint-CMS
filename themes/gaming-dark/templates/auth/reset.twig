{% extends 'layout.twig' %}
{% block content %}
<div style="max-width:420px;margin:3rem auto;">
  <div class="cf-card">
    <div class="cf-card-header">🔐 {{ trans('auth.reset.title') }}</div>
    <div class="cf-card-body">
      {% if errors is defined %}
        <div class="cf-alert cf-alert-error">
          {% for e in errors %}<div>{{ e }}</div>{% endfor %}
        </div>
      {% endif %}
      <form method="POST" action="/wachtwoord-herstellen/{{ token }}">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.reset.password_label') }}</label>
          <input class="cf-input" type="password" name="password" required minlength="8" autofocus autocomplete="new-password">
        </div>
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.register.password_confirm_label') }}</label>
          <input class="cf-input" type="password" name="password_confirm" required minlength="8" autocomplete="new-password">
        </div>
        <button type="submit" class="cf-btn" style="width:100%;justify-content:center;">{{ trans('auth.reset.submit') }}</button>
      </form>
    </div>
  </div>
</div>
{% endblock %}
