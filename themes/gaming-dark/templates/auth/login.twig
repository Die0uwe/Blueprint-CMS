{% extends 'layout.twig' %}
{% block content %}
<div style="max-width:420px;margin:3rem auto;">
  <div class="cf-card">
    <div class="cf-card-header">🔐 {{ trans('auth.login.title') }}</div>
    <div class="cf-card-body">
      {% if error is defined %}<div class="cf-alert cf-alert-error">{{ error }}</div>{% endif %}
      {% if oauth_error is defined and oauth_error %}<div class="cf-alert cf-alert-error">{{ trans('auth.oauth.error.' ~ oauth_error, {provider: oauth_provider_label|default('')}) }}</div>{% endif %}
      {% if password_reset_done is defined and password_reset_done %}<div class="cf-alert cf-alert-success">{{ trans('auth.reset.done') }}</div>{% endif %}
      <form method="POST" action="/login">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.login.identifier_label') }}</label>
          <input class="cf-input" type="text" name="identifier" required autofocus>
        </div>
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('auth.login.password_label') }}</label>
          <input class="cf-input" type="password" name="password" required>
        </div>
        <button type="submit" class="cf-btn" style="width:100%;justify-content:center;">{{ trans('auth.login.submit') }}</button>
      </form>
      <p style="text-align:center;margin:.75rem 0 0;font-size:.85rem;"><a href="/wachtwoord-vergeten">{{ trans('auth.login.forgot_link') }}</a></p>

      {% include 'auth/_oauth_buttons.twig' %}

      <p style="text-align:center;margin-top:1rem;font-size:.85rem;color:var(--muted);">
        {{ trans('auth.login.no_account') }} <a href="/register">{{ trans('auth.login.register_link') }}</a> {{ trans('auth.login.register_hint') }}
      </p>
    </div>
  </div>
</div>
{% endblock %}
