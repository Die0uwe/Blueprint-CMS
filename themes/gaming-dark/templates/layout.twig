<!DOCTYPE html>
<html lang="{{ settings.locale|default('nl') }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ page_title|default('') }}{% endblock %}{% if settings.site_name is defined %} — {{ settings.site_name }}{% endif %}</title>
<meta name="description" content="{% block meta_desc %}{{ settings.site_description|default('') }}{% endblock %}">
{% if settings.site_icon is defined and settings.site_icon %}
<link rel="icon" href="{{ settings.site_icon }}">
{% endif %}
<link rel="stylesheet" href="{{ asset('css/blueprint.css') }}">
{# Thema-kleuren (v1.19.0) — tot nu toe deed thema-wissel LETTERLIJK NIETS
   zichtbaars: layout.twig was al identiek tussen default/gaming-dark (zelfde
   templates), blueprint.css bevat maar één, hardcoded kleurenpalet, en de
   `asset()`-Twig-functie verwijst altijd naar het gedeelde /assets/, nooit
   naar een thema-eigen /themes/<slug>/assets/-map. `theme.json`'s `colors`-
   blok werd wél al als Twig-global ingelezen (zie ThemeManager::boot()) maar
   nergens gebruikt. blueprint.css is al volledig op CSS custom properties
   gebouwd (--bg/--surface/--accent/enz.), dus i.p.v. een aparte stylesheet
   per thema volstaat het overschrijven van diezelfde variabelen hier — het
   actieve thema's eigen theme.json bepaalt de waarden, zonder dat
   blueprint.css zelf iets hoeft te weten van welk thema actief is. #}
{% if theme.colors is defined and theme.colors %}
<style>
:root {
  {% if theme.colors.bg      is defined %}--bg: {{ theme.colors.bg }};{% endif %}
  {% if theme.colors.surface is defined %}--surface: {{ theme.colors.surface }};{% endif %}
  {% if theme.colors.accent  is defined %}--accent: {{ theme.colors.accent }};{% endif %}
  {% if theme.colors.accent2 is defined %}--accent2: {{ theme.colors.accent2 }};{% endif %}
  {% if theme.colors.gold    is defined %}--gold: {{ theme.colors.gold }};{% endif %}
  {% if theme.colors.text    is defined %}--text: {{ theme.colors.text }};{% endif %}
  {% if theme.colors.muted   is defined %}--muted: {{ theme.colors.muted }};{% endif %}
  {% if theme.colors.success is defined %}--success: {{ theme.colors.success }};{% endif %}
  {% if theme.colors.error   is defined %}--error: {{ theme.colors.error }};{% endif %}
}
</style>
{% endif %}
{% block head %}{% endblock %}
</head>
<body class="cf-theme-dark" data-theme-slug="{{ theme.slug|default('') }}" data-theme-name="{{ theme.name|default('') }}">

{# HEADER ZONE #}
<header id="cf-header">
  <div class="cf-container">
    <a href="/" class="cf-logo-wrap">
      <span class="cf-logo">🔮 {{ settings.site_name|default('Blueprint CMS') }}</span>
      {% if settings.site_motd is defined and settings.site_motd %}
        <span class="cf-motd">{{ settings.site_motd }}</span>
      {% endif %}
    </a>
    <nav class="cf-nav">
      <a href="/news" class="cf-nav-link">Nieuws</a>
      <a href="/blog" class="cf-nav-link">Blog</a>
      <a href="/forum" class="cf-nav-link">Forum</a>
      <a href="/downloads" class="cf-nav-link">Downloads</a>
      {% for page in menu_pages %}
        <a href="/page/{{ page.slug }}" class="cf-nav-link">{{ page.title }}</a>
      {% endfor %}
      <a href="/contact" class="cf-nav-link">Contact</a>
    </nav>
    <div class="cf-header-actions">
      {% if auth.check() %}
        <a href="/admin" class="cf-btn-sm">Admin</a>
        <a href="/logout" class="cf-btn-sm cf-btn-ghost">Uitloggen</a>
      {% else %}
        <a href="/login" class="cf-btn-sm">Inloggen</a>
      {% endif %}
    </div>
  </div>
</header>

{# HEADER-ZONE BLOKKEN — #cf-header hierboven heeft een vaste hoogte (logo/nav/acties
   in één rij), dus geplaatste blokken komen in een eigen, los-hoge balk erónder i.p.v.
   erin geperst — dat voorkomt overflow van blokken met willekeurige inhoud. #}
{% if zones.header is defined and zones.header %}
<div id="cf-header-blocks" class="cf-container">
  {% for block in zones.header %}
    {{ render_block(block)|raw }}
  {% endfor %}
</div>
{% endif %}

{# TOP MENU ZONE — apart van het vaste hoofdmenu in #cf-header, zoals de
   projectblueprint Header en Top Menu als twee losse layout-onderdelen beschrijft. #}
{% if zones.topmenu is defined and zones.topmenu %}
<nav id="cf-topmenu" class="cf-container">
  {% for block in zones.topmenu %}
    {{ render_block(block)|raw }}
  {% endfor %}
</nav>
{% endif %}

{# MAIN LAYOUT #}
<div id="cf-main" class="cf-layout">

  {# LINKER SIDEBAR #}
  {% if zones.sidebar_left is defined and zones.sidebar_left %}
  <aside id="cf-sidebar-left" class="cf-sidebar">
    {% for block in zones.sidebar_left %}
      {{ render_block(block)|raw }}
    {% endfor %}
  </aside>
  {% endif %}

  {# CENTER CONTENT #}
  <main id="cf-content">
    {% block content %}{% endblock %}
  </main>

  {# RECHTER SIDEBAR #}
  {% if zones.sidebar_right is defined and zones.sidebar_right %}
  <aside id="cf-sidebar-right" class="cf-sidebar">
    {% for block in zones.sidebar_right %}
      {{ render_block(block)|raw }}
    {% endfor %}
  </aside>
  {% endif %}

</div>

{# FOOTER #}
<footer id="cf-footer">
  <div class="cf-container">
    {% if zones.footer is defined and zones.footer %}
    <div id="cf-footer-blocks">
      {% for block in zones.footer %}
        {{ render_block(block)|raw }}
      {% endfor %}
    </div>
    {% endif %}
    <p>© {{ "now"|date("Y") }} {{ settings.site_name|default('Blueprint CMS') }}</p>
    <p class="cf-footer-links">
      <a href="https://www.dieouwe.nl">DieOuwe</a> ·
      <a href="https://www.slayeralliance.com">Slayer Alliance</a> ·
      <a href="https://github.com/Die0uwe/Bluprint-CMS">GitHub</a>
    </p>
  </div>
</footer>

<script src="{{ asset('js/blueprint.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
