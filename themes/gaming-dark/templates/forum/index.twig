{% extends 'layout.twig' %}
{% block content %}
<div class="cf-page-header">
  <div class="cf-breadcrumb"><a href="/">Home</a> → Forum</div>
  <h1>💬 Forum</h1>
</div>

<div class="cf-forum-boards">
  {% for board in boards %}
  <div class="cf-card" style="margin-bottom:1rem;">
    <div class="cf-card-body" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <div style="flex:1;min-width:200px;">
        <h2 style="font-size:1.1rem;margin-bottom:.3rem;">
          <a href="/forum/{{ board.slug }}">{{ board.name }}</a>
        </h2>
        {% if board.description %}
          <p style="color:var(--text-dim);font-size:.875rem;">{{ board.description }}</p>
        {% endif %}
      </div>
      <div style="text-align:center;min-width:70px;">
        <div style="font-weight:800;">{{ board.topic_count }}</div>
        <div style="color:var(--muted);font-size:.75rem;">topics</div>
      </div>
      <div style="text-align:center;min-width:70px;">
        <div style="font-weight:800;">{{ board.post_count }}</div>
        <div style="color:var(--muted);font-size:.75rem;">berichten</div>
      </div>
      <div style="min-width:180px;font-size:.8rem;color:var(--muted);">
        {% if board.last_topic_title %}
          Laatste: <a href="/forum/{{ board.slug }}/{{ board.last_topic_slug }}">{{ board.last_topic_title }}</a>
          {% if board.last_post_username %}<br>door {{ board.last_post_username }}{% endif %}
        {% else %}
          Nog geen topics.
        {% endif %}
      </div>
    </div>
  </div>
  {% else %}
  <p style="color:var(--muted);">Er zijn nog geen forumborden aangemaakt.</p>
  {% endfor %}
</div>
{% endblock %}
