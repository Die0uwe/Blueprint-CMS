{% extends 'layout.twig' %}
{% block content %}
<div style="max-width:560px;margin:3rem auto;">
  <div class="cf-card">
    <div class="cf-card-header">👤 {{ trans('profile.title') }}</div>
    <div class="cf-card-body">

      {% if language is defined and language == 'updated' %}
        <div class="cf-alert cf-alert-success">{{ trans('profile.language_updated') }}</div>
      {% endif %}

      {% if bio_status is defined and bio_status == 'updated' %}
        <div class="cf-alert cf-alert-success">{{ trans('profile.bio_updated') }}</div>
      {% endif %}

      {% if oauth_error is defined and oauth_error %}<div class="cf-alert cf-alert-error">{{ trans('auth.oauth.error.' ~ oauth_error, {provider: oauth_error_provider}) }}</div>{% endif %}
      {% for p in oauth_providers %}
        {% if p.status == 'connected' %}
          <div class="cf-alert cf-alert-success">{{ p.label }}-account gekoppeld.</div>
        {% elseif p.status == 'disconnected' %}
          <div class="cf-alert cf-alert-success">{{ p.label }}-account ontkoppeld.</div>
        {% endif %}
      {% endfor %}

      <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        {% if user.avatar_url %}
          <img src="{{ user.avatar_url }}" alt="" style="width:64px;height:64px;border-radius:50%;object-fit:cover;">
        {% else %}
          <div style="width:64px;height:64px;border-radius:50%;background:var(--cf-accent,#a11692);"></div>
        {% endif %}
        <div>
          <strong>{{ user.display_name ?: user.username }}</strong><br>
          <span style="color:var(--muted);font-size:.85rem;">{{ user.email }}</span>
        </div>
      </div>

      <form method="POST" action="/profiel/avatar" enctype="multipart/form-data">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('profile.avatar_label') }}</label>
          <input class="cf-input" type="file" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp" required>
        </div>
        <button type="submit" class="cf-btn">{{ trans('profile.avatar_submit') }}</button>
      </form>

      <hr style="margin:1rem 0;border-color:var(--border);">

      <form method="POST" action="/profiel/bio">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('profile.bio_label') }}</label>
          <textarea class="cf-input" name="bio" rows="4" maxlength="500">{{ user.bio }}</textarea>
          <p style="color:var(--muted);font-size:.78rem;margin:.35rem 0 0;">{{ trans('profile.bio_hint') }}</p>
        </div>
        <button type="submit" class="cf-btn">{{ trans('profile.bio_submit') }}</button>
      </form>

      <hr style="margin:1rem 0;border-color:var(--border);">

      <form method="POST" action="/profiel/taal">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('profile.language_label') }}</label>
          <select name="locale" class="cf-input" style="max-width:220px;">
            {% for l in supported_locales %}
              <option value="{{ l }}" {{ user.locale == l ? 'selected' : '' }}>{{ l|upper }}</option>
            {% endfor %}
          </select>
          <p style="color:var(--muted);font-size:.78rem;margin:.35rem 0 0;">{{ trans('profile.language_hint') }}</p>
        </div>
        <button type="submit" class="cf-btn">{{ trans('profile.language_submit') }}</button>
      </form>

      <hr style="margin:1.5rem 0;border-color:var(--border);">

      <h3 style="margin-bottom:.75rem;">{{ trans('profile.linked_accounts') }}</h3>
      {% if connections|length == 0 %}
        <p style="color:var(--muted);font-size:.9rem;">{{ trans('profile.no_linked_accounts') }}</p>
      {% endif %}
      {% for c in connections %}
        <div style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid var(--border);">
          <span>{{ c.provider|capitalize }} — {{ c.data.username ?? c.data.login ?? c.data.battletag ?? c.data.name ?? '—' }}</span>
          <form method="POST" action="/auth/{{ c.provider }}/disconnect" style="margin:0;">
            {{ csrf_field()|raw }}
            <button type="submit" class="cf-btn cf-btn-danger" style="padding:.25rem .75rem;font-size:.8rem;">{{ trans('profile.disconnect') }}</button>
          </form>
        </div>
      {% endfor %}

      {# Golf 10: was hardcoded op alleen Discord — nu een knop per provider
         die nog niet gekoppeld is, voor alle vier ondersteunde providers. #}
      <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem;">
        {% for p in oauth_providers %}
          {% if p.usable and connections|filter(c => c.provider == p.slug)|length == 0 %}
            <a href="/auth/{{ p.slug }}" class="cf-btn" style="background:{{ p.color }};color:{{ p.text }};{% if p.slug == 'google' %}border:1px solid var(--border);{% endif %}">{{ p.label }} {{ trans('profile.connect_suffix') }}</a>
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
</div>
{% endblock %}
