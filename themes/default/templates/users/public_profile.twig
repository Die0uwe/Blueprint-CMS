{% extends 'layout.twig' %}
{% block content %}
<div style="max-width:640px;margin:3rem auto;">

  <div class="cf-card" style="margin-bottom:1.5rem;">
    <div class="cf-card-body" style="display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap;">
      {% if member.avatar_url %}
        <img src="{{ member.avatar_url }}" alt="" style="width:88px;height:88px;border-radius:50%;object-fit:cover;">
      {% else %}
        <div style="width:88px;height:88px;border-radius:50%;background:var(--accent);"></div>
      {% endif %}
      <div style="flex:1;min-width:200px;">
        <h1 style="margin:0 0 .2rem;font-size:1.4rem;">{{ member.display_name|default(member.username) }}</h1>
        <div style="color:var(--muted);font-size:.85rem;">
          {{ trans('members.since') }} {{ member.created_at|date('d M Y') }}
        </div>
        {% if member.bio %}
          <p style="margin-top:.8rem;white-space:pre-wrap;">{{ member.bio }}</p>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="cf-card" style="margin-bottom:1.5rem;">
    <div class="cf-card-header">💬 {{ trans('members.recent_topics') }}</div>
    <div class="cf-card-body">
      {% for topic in recent_topics %}
        <div style="padding:.5rem 0;{% if not loop.last %}border-bottom:1px solid var(--border);{% endif %}">
          <a href="/forum/{{ topic.board_slug }}/{{ topic.slug }}">{{ topic.title }}</a>
          <div style="color:var(--muted);font-size:.78rem;">
            {{ topic.board_name }} · {{ topic.created_at|date('d M Y') }} · {{ topic.reply_count }} {{ trans('members.replies') }}
          </div>
        </div>
      {% else %}
        <p style="color:var(--muted);">{{ trans('members.no_topics') }}</p>
      {% endfor %}
    </div>
  </div>

  <div class="cf-card">
    <div class="cf-card-header">🗨️ {{ trans('members.recent_posts') }}</div>
    <div class="cf-card-body">
      {% for post in recent_posts %}
        <div style="padding:.5rem 0;{% if not loop.last %}border-bottom:1px solid var(--border);{% endif %}">
          <a href="/forum/{{ post.board_slug }}/{{ post.topic_slug }}#post-{{ post.id }}">{{ post.topic_title }}</a>
          <div style="color:var(--muted);font-size:.85rem;margin-top:.2rem;">{{ post.content|slice(0,140) }}{% if post.content|length > 140 %}…{% endif %}</div>
          <div style="color:var(--muted);font-size:.78rem;margin-top:.2rem;">{{ post.created_at|date('d M Y H:i') }}</div>
        </div>
      {% else %}
        <p style="color:var(--muted);">{{ trans('members.no_posts') }}</p>
      {% endfor %}
    </div>
  </div>

</div>
{% endblock %}
