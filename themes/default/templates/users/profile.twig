{% extends 'layout.twig' %}
{% block content %}
<div style="max-width:560px;margin:3rem auto;">
  <div class="cf-card">
    <div class="cf-card-header">👤 {{ trans('profile.title') }}</div>
    <div class="cf-card-body">

      {% if language is defined and language == 'updated' %}
        <div class="cf-alert cf-alert-success">{{ trans('profile.language_updated') }}</div>
      {% endif %}

      {% if bio_status is defined and bio_status == 'updated' %}
        <div class="cf-alert cf-alert-success">{{ trans('profile.bio_updated') }}</div>
      {% endif %}

      {% for f in oauth_flash|default([]) %}
        {% if f.status == 'connected' %}
          <div class="cf-alert cf-alert-success">{{ f.label }}-{{ trans('profile.flash_connected') }}</div>
        {% elseif f.status == 'disconnected' %}
          <div class="cf-alert cf-alert-success">{{ f.label }}-{{ trans('profile.flash_disconnected') }}</div>
        {% elseif f.status == 'already_linked' %}
          <div class="cf-alert cf-alert-error">{{ trans('profile.flash_already_linked') }}</div>
        {% elseif f.status == 'last_login' %}
          <div class="cf-alert cf-alert-error">{{ f.label }} {{ trans('profile.flash_last_login') }}</div>
        {% endif %}
      {% endfor %}

      <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        {% if user.avatar_url %}
          <img src="{{ user.avatar_url }}" alt="" style="width:64px;height:64px;border-radius:50%;object-fit:cover;">
        {% else %}
          <div style="width:64px;height:64px;border-radius:50%;background:var(--cf-accent,#a11692);"></div>
        {% endif %}
        <div>
          <strong>{{ user.display_name ?: user.username }}</strong><br>
          <span style="color:var(--muted);font-size:.85rem;">{{ user.email }}</span>
        </div>
      </div>

      <form method="POST" action="/profiel/avatar" enctype="multipart/form-data">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('profile.avatar_label') }}</label>
          <input class="cf-input" type="file" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp" required>
        </div>
        <button type="submit" class="cf-btn">{{ trans('profile.avatar_submit') }}</button>
      </form>

      <hr style="margin:1rem 0;border-color:var(--border);">

      <form method="POST" action="/profiel/bio">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('profile.bio_label') }}</label>
          <textarea class="cf-input" name="bio" rows="4" maxlength="500">{{ user.bio }}</textarea>
          <p style="color:var(--muted);font-size:.78rem;margin:.35rem 0 0;">{{ trans('profile.bio_hint') }}</p>
        </div>
        <button type="submit" class="cf-btn">{{ trans('profile.bio_submit') }}</button>
      </form>

      <hr style="margin:1rem 0;border-color:var(--border);">

      <form method="POST" action="/profiel/taal">
        {{ csrf_field()|raw }}
        <div class="cf-form-group">
          <label class="cf-label">{{ trans('profile.language_label') }}</label>
          <select name="locale" class="cf-input" style="max-width:220px;">
            {% for l in supported_locales %}
              <option value="{{ l }}" {{ user.locale == l ? 'selected' : '' }}>{{ l|upper }}</option>
            {% endfor %}
          </select>
          <p style="color:var(--muted);font-size:.78rem;margin:.35rem 0 0;">{{ trans('profile.language_hint') }}</p>
        </div>
        <button type="submit" class="cf-btn">{{ trans('profile.language_submit') }}</button>
      </form>

      <hr style="margin:1.5rem 0;border-color:var(--border);">

      <h3 style="margin-bottom:.75rem;">{{ trans('profile.linked_accounts') }}</h3>
      {# Eén rij per provider uit de ProviderRegistry: gekoppeld (met
         ontkoppelknop, POST + CSRF) of koppelbaar (link naar de module).
         Niet-koppelbare, niet-gekoppelde providers worden niet getoond. #}
      {% if linked_accounts|length == 0 %}
        <p style="color:var(--muted);font-size:.9rem;">{{ trans('profile.no_providers_available') }}</p>
      {% endif %}
      {% for a in linked_accounts %}
        <div style="display:flex;justify-content:space-between;align-items:center;gap:.75rem;padding:.6rem 0;border-bottom:1px solid var(--border);">
          <div style="min-width:0;">
            <span style="display:inline-block;width:1.6rem;height:1.6rem;line-height:1.6rem;text-align:center;border-radius:6px;background:{{ a.color }};color:{{ a.text_color }};margin-right:.4rem;">{{ a.icon }}</span>
            <strong>{{ a.label }}</strong>
            {% if a.linked %}
              <span style="color:var(--muted);font-size:.85rem;">— {{ trans('profile.status_connected') }}{% if a.name %}: {{ a.name }}{% endif %}</span>
            {% else %}
              <span style="color:var(--muted);font-size:.85rem;">— {{ trans('profile.status_not_connected') }}</span>
            {% endif %}
            {% if a.linked and not a.can_disconnect %}
              <div style="font-size:.78rem;color:var(--muted);margin-top:.2rem;">🔒 {{ trans('profile.disconnect_blocked') }}</div>
            {% endif %}
          </div>
          <div style="flex-shrink:0;">
            {% if a.linked %}
              {% if a.can_disconnect %}
                <form method="POST" action="{{ a.disconnect_url }}" style="margin:0;">
                  {{ csrf_field()|raw }}
                  <button type="submit" class="cf-btn cf-btn-danger" style="padding:.25rem .75rem;font-size:.8rem;">{{ trans('profile.disconnect') }}</button>
                </form>
              {% endif %}
            {% elseif a.can_connect %}
              <a href="{{ a.link_url }}" class="cf-btn" style="background:{{ a.color }};color:{{ a.text_color }};border:1px solid var(--border);padding:.25rem .75rem;font-size:.8rem;">{{ a.label }} {{ trans('profile.connect_suffix') }}</a>
            {% endif %}
          </div>
        </div>
      {% endfor %}

    </div>
  </div>
</div>
{% endblock %}
