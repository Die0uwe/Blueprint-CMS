{% extends 'layout.twig' %}
{% block content %}
<div class="cf-page-header">
  <div class="cf-breadcrumb"><a href="/">Home</a> → <a href="/galerij">Galerij</a>{% if parent %} → <a href="/galerij/{{ parent.slug }}">{{ parent.name }}</a>{% endif %} → {{ album.name }}</div>
  <h1>📷 {{ album.name }}</h1>
  {% if album.description %}<p style="color:var(--muted);">{{ album.description }}</p>{% endif %}
</div>

{% if can_manage %}
<div style="margin-bottom:1rem;">
  <a href="/admin/gallery/{{ album.id }}/beheer" class="cf-btn">⚙️ Album beheren</a>
</div>
{% endif %}

{% if subalbums %}
<h2 class="cf-gallery-section-title">Subalbums</h2>
<div class="cf-gallery-albums-grid" style="margin-bottom:1.5rem;">
  {% for sub in subalbums %}
  <a href="/galerij/{{ sub.slug }}" class="cf-gallery-album-card">
    <div class="cf-gallery-album-cover">
      {% if sub.cover_thumbnail %}
        <img src="/media/{{ sub.cover_thumbnail }}" alt="{{ sub.name }}" loading="lazy">
      {% elseif sub.cover_media_type == 'video' %}
        <div class="cf-gallery-album-cover-placeholder">▶️</div>
      {% else %}
        <div class="cf-gallery-album-cover-placeholder">📷</div>
      {% endif %}
    </div>
    <div class="cf-gallery-album-info">
      <h3>{{ sub.name }}</h3>
      {% if sub.description %}<p>{{ sub.description }}</p>{% endif %}
      <span class="cf-gallery-album-count">{{ sub.item_count }} item{{ sub.item_count == 1 ? '' : 's' }}</span>
    </div>
  </a>
  {% endfor %}
</div>
{% endif %}

{% if styles or active_tag %}
<nav class="cf-gallery-filter" aria-label="Filter op stijl" style="display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1rem;">
  <a href="/galerij/{{ album.slug }}" class="cf-btn-sm {{ active_style or active_tag ? 'cf-btn-ghost' : '' }}">Alle</a>
  {% for st in styles %}
    <a href="/galerij/{{ album.slug }}?stijl={{ st.slug }}" class="cf-btn-sm {{ st.slug == active_style ? '' : 'cf-btn-ghost' }}"{% if st.slug == active_style %} aria-current="true"{% endif %}>{{ st.label }} <small>({{ st.count }})</small></a>
  {% endfor %}
  {% if active_tag %}
    <a href="/galerij/{{ album.slug }}" class="cf-btn-sm">#{{ active_tag }} ✕</a>
  {% endif %}
</nav>
{% endif %}

<div class="cf-gallery-items-grid">
  {% for item in items %}
  <a href="/media/{{ item.file_path }}" class="cf-gallery-item"
     aria-label="{{ item.media_type == 'video' ? 'Video afspelen: ' : 'Bekijk groot: ' }}{{ item.title|default(item.original_filename) }}"
     data-lightbox="{{ item.media_type }}"
     data-src="/media/{{ item.file_path }}"
     data-poster="{{ item.thumbnail_path ? '/media/' ~ item.thumbnail_path : '' }}"
     data-title="{{ item.title|default(item.original_filename) }}"
     data-author="{{ item.display_name|default(item.username) }}"
     data-date="{{ item.created_at|date('d M Y') }}"
     data-description="{{ item.description|default('') }}"
     data-style="{{ item.style|default('') }}"
     data-tags="{{ item.tag_list|join(', ') }}">
    {% if item.thumbnail_path or item.media_type == 'image' %}
      <img src="/media/{{ item.thumbnail_path|default(item.file_path) }}" alt="{{ item.title|default(item.original_filename) }}" loading="lazy">
    {% else %}
      <div class="cf-gallery-video-placeholder">▶️</div>
    {% endif %}
    {% if item.media_type == 'video' %}<span class="cf-gallery-play-badge" aria-hidden="true">▶</span>{% endif %}
    {% if item.title %}<span class="cf-gallery-item-title">{{ item.title }}</span>{% endif %}
  </a>
  {% else %}
  {% if not subalbums %}<p style="color:var(--muted);">{{ active_style or active_tag ? "Geen items met dit filter." : "Dit album bevat nog geen foto's of video's." }}</p>{% endif %}
  {% endfor %}
</div>

{% if pagination.total > 1 %}
<nav class="cf-pagination" aria-label="Paginering">
  {% for p in 1..pagination.total %}
    <a href="/galerij/{{ album.slug }}?page={{ p }}{% if active_style %}&stijl={{ active_style }}{% endif %}{% if active_tag %}&tag={{ active_tag }}{% endif %}" class="cf-btn-sm {{ p == pagination.current ? '' : 'cf-btn-ghost' }}"{% if p == pagination.current %} aria-current="page"{% endif %}>{{ p }}</a>
  {% endfor %}
</nav>
{% endif %}

<div id="cf-gallery-lightbox" class="cf-gallery-lightbox" role="dialog" aria-modal="true" aria-label="Mediaviewer" hidden>
  <button type="button" class="cf-gallery-lightbox-close" aria-label="Sluiten">✕</button>
  <button type="button" class="cf-gallery-lightbox-nav cf-gallery-lightbox-prev" aria-label="Vorige">‹</button>
  <button type="button" class="cf-gallery-lightbox-nav cf-gallery-lightbox-next" aria-label="Volgende">›</button>
  <div class="cf-gallery-lightbox-body">
    <div class="cf-gallery-lightbox-media"></div>
    <div class="cf-gallery-lightbox-meta">
      <h3 class="cf-gallery-lightbox-title"></h3>
      <p class="cf-gallery-lightbox-description"></p>
      <div class="cf-gallery-lightbox-sub"></div>
    </div>
  </div>
</div>

<script>
(function () {
  // Eenvoudige, framework-loze lightbox — geen externe library nodig voor
  // "klik op miniatuur → toon groot". Video-items krijgen een native
  // <video controls>-element i.p.v. een <img>.
  var lightbox = document.getElementById('cf-gallery-lightbox');
  if (!lightbox) return;

  var mediaEl = lightbox.querySelector('.cf-gallery-lightbox-media');
  var titleEl = lightbox.querySelector('.cf-gallery-lightbox-title');
  var descEl  = lightbox.querySelector('.cf-gallery-lightbox-description');
  var subEl   = lightbox.querySelector('.cf-gallery-lightbox-sub');
  var closeEl = lightbox.querySelector('.cf-gallery-lightbox-close');

  var prevEl = lightbox.querySelector('.cf-gallery-lightbox-prev');
  var nextEl = lightbox.querySelector('.cf-gallery-lightbox-next');
  var items  = Array.prototype.slice.call(document.querySelectorAll('.cf-gallery-item'));
  var current = -1;
  var lastFocus = null;
  var player = null;

  function show(index) {
    var item = items[index];
    if (!item) return;
    current = index;
    if (player) { player.destroy(); player = null; }
    mediaEl.innerHTML = '';
    if (item.dataset.lightbox === 'video') {
      // Ingebouwde speler (cf-player.js); native <video controls> als terugval.
      if (window.CFPlayer) {
        player = CFPlayer.create(item.dataset.src, { poster: item.dataset.poster || '', autoplay: true, title: item.dataset.title || '' });
        mediaEl.appendChild(player.holder);
      } else {
        var video = document.createElement('video');
        video.src = item.dataset.src;
        video.controls = true;
        video.autoplay = true;
        mediaEl.appendChild(video);
      }
    } else {
      var img = document.createElement('img');
      img.alt = item.dataset.title || '';
      img.addEventListener('error', function () {
        mediaEl.innerHTML = '';
        var msg = document.createElement('p');
        msg.className = 'cf-gallery-lightbox-error';
        msg.setAttribute('role', 'alert');
        msg.textContent = 'Deze afbeelding kan niet worden geladen.';
        mediaEl.appendChild(msg);
      });
      img.src = item.dataset.src;
      mediaEl.appendChild(img);
    }
    titleEl.textContent = item.dataset.title || '';
    descEl.textContent  = item.dataset.description || '';
    descEl.hidden = !item.dataset.description;
    subEl.textContent = 'door ' + item.dataset.author + ' · ' + item.dataset.date
      + (item.dataset.style ? ' · ' + item.dataset.style : '')
      + (item.dataset.tags ? ' · #' + item.dataset.tags.split(', ').join(' #') : '');
    lightbox.setAttribute('aria-label', item.dataset.title || 'Mediaviewer');
    var multi = items.length > 1;
    prevEl.hidden = nextEl.hidden = !multi;
  }

  function open(index) {
    lastFocus = document.activeElement;
    show(index);
    lightbox.hidden = false;
    document.body.classList.add('cf-lightbox-open');
    closeEl.focus();
  }

  function close() {
    if (player) { player.destroy(); player = null; }
    lightbox.hidden = true;
    mediaEl.innerHTML = '';
    document.body.classList.remove('cf-lightbox-open');
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  function step(dir) {
    if (items.length < 2) return;
    show((current + dir + items.length) % items.length);
  }

  items.forEach(function (el, i) {
    el.addEventListener('click', function (e) {
      // Ctrl/Cmd/Shift/middelste klik: laat de browser het bestand zelf openen.
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.button === 1) return;
      e.preventDefault();
      open(i);
    });
  });

  closeEl.addEventListener('click', close);
  prevEl.addEventListener('click', function () { step(-1); });
  nextEl.addEventListener('click', function () { step(1); });
  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) close();
  });
  document.addEventListener('keydown', function (e) {
    if (lightbox.hidden) return;
    if (e.key === 'Escape') { close(); return; }
    // Pijltjes blijven voor de videospeler (±5 s) zodra de focus daarin staat.
    var inPlayer = e.target.closest && e.target.closest('.cf-player');
    if (!inPlayer && e.key === 'ArrowLeft')  { step(-1); e.preventDefault(); }
    if (!inPlayer && e.key === 'ArrowRight') { step(1);  e.preventDefault(); }
    if (e.key === 'Tab') {                     // focus-trap binnen de dialoog
      var f = Array.prototype.filter.call(
        lightbox.querySelectorAll('button, a[href], input, select, [tabindex]:not([tabindex="-1"])'),
        function (n) { return !n.hidden && n.offsetParent !== null; });
      if (!f.length) return;
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { last.focus(); e.preventDefault(); }
      else if (!e.shiftKey && document.activeElement === last) { first.focus(); e.preventDefault(); }
    }
  });
})();
</script>
{% endblock %}
