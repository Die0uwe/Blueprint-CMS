{% extends 'layout.twig' %}

{% block content %}
<div class="cf-page-header cf-animate">
  <h1>Welkom bij {{ settings.site_name|default('Blueprint CMS') }}</h1>
  <p style="color:var(--text-dim);margin-top:.5rem;">Jouw community, jouw regels.</p>
</div>

{# Blokken die in de zone "Content" zijn geplaatst (Admin → Blokken). Deze zone werd
   nergens gerenderd, waardoor o.a. een HTML-blok daar nooit zichtbaar was. #}
{% if zones.content is defined and zones.content %}
<div id="cf-content-blocks" class="cf-content-blocks">
  {% for block in zones.content %}
    {{ render_block(block)|raw }}
  {% endfor %}
</div>
{% endif %}

{% if quick_post and quick_post.types %}
{# Standaard dicht: alleen een knop. Bij een foutmelding (te snel, leeg, …) staat het formulier open. #}
<details class="cf-quickpost" id="cf-quickpost"{% if quick_post.status in ['wacht', 'leeg', 'bord', 'fout'] %} open{% endif %}>
  <summary class="cf-btn cf-quickpost-toggle">✍️ Snel plaatsen</summary>
  <div class="cf-quickpost-panel">
  <div aria-live="polite">{% if quick_post.status == 'wacht' %}<p class="cf-alert cf-alert-warning" role="status">Even geduld — je kunt pas over een paar seconden opnieuw plaatsen.</p>{% elseif quick_post.status == 'leeg' %}<p class="cf-alert cf-alert-error" role="alert">Titel en inhoud zijn verplicht.</p>{% elseif quick_post.status == 'bord' %}<p class="cf-alert cf-alert-error" role="alert">Kies een geldig forumbord.</p>{% elseif quick_post.status == 'fout' %}<p class="cf-alert cf-alert-error" role="alert">Plaatsen mislukt.</p>{% endif %}</div>
  <form method="post" action="/quick-post" class="cf-quickpost-form">
    {{ csrf_field()|raw }}
    <div class="cf-quickpost-row">
      <label for="cf-qp-type" class="cf-sr-only">Type bericht</label>
      <select name="type" id="cf-qp-type" class="cf-input">
        {% if 'post' in quick_post.types %}<option value="post">📰 Nieuwsbericht</option>{% endif %}
        {% if 'blog' in quick_post.types %}<option value="blog">📝 Blogpost</option>{% endif %}
        {% if 'forum' in quick_post.types %}<option value="forum">💬 Forumtopic</option>{% endif %}
      </select>
      {% if quick_post.boards %}
      <label for="cf-qp-board" class="cf-sr-only">Forumbord</label>
      <select name="board" id="cf-qp-board" class="cf-input">
        {% for b in quick_post.boards %}<option value="{{ b.slug }}">{{ b.name }}</option>{% endfor %}
      </select>
      {% endif %}
    </div>
    <label for="cf-qp-title" class="cf-sr-only">Titel</label>
    <input type="text" name="title" id="cf-qp-title" class="cf-input" maxlength="200" placeholder="Titel" required>
    <label for="cf-qp-content" class="cf-sr-only">Bericht</label>
    <textarea name="content" id="cf-qp-content" class="cf-input" rows="4" placeholder="Wat wil je delen?" required></textarea>
    <button type="submit" class="cf-btn">Plaatsen</button>
  </form>
  <script>(function(){var t=document.getElementById('cf-qp-type'),b=document.getElementById('cf-qp-board');if(!t||!b)return;function s(){b.style.display=t.value==='forum'?'':'none';}t.addEventListener('change',s);s();})();</script>
  </div>
</details>
{% endif %}

{% if latest_news %}
<section>
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
    <h2 style="font-size:1.1rem;font-weight:700;">📰 Laatste Nieuws</h2>
    <a href="/news" class="cf-btn-sm cf-btn-ghost">Alle artikelen →</a>
  </div>
  <div class="cf-news-grid">
    {% for item in latest_news %}
    <article class="cf-news-item">
      {% if item.featured_image %}
        <img class="cf-news-img" src="{{ item.featured_image }}" alt="{{ item.title }}">
      {% else %}
        <div class="cf-news-img" style="display:flex;align-items:center;justify-content:center;font-size:2.5rem;">📰</div>
      {% endif %}
      <div class="cf-news-body">
        <div class="cf-news-cat">Nieuws</div>
        <h3 class="cf-news-title"><a href="/news/{{ item.slug }}">{{ item.title }}</a></h3>
        <p class="cf-news-summary">{{ item.summary|default(item.content|striptags|slice(0,120)) }}…</p>
        <div class="cf-news-meta">
          <span>✍️ {{ item.display_name|default(item.username) }}</span>
          <span>👁️ {{ item.views }}</span>
          <span>{{ item.published_at|date('d M Y') }}</span>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
