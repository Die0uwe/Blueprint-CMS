{% extends 'layout.twig' %}
{% block content %}
<div class="cf-page-header">
  <div class="cf-breadcrumb"><a href="/">Home</a> → <a href="/admin">Admin</a> → <a href="/admin/contact">Contact</a> → Bericht</div>
  <h1>{{ message.subject|default('(geen onderwerp)') }}</h1>
  <div class="cf-news-meta" style="margin-top:.5rem;">
    <span>👤 {{ message.name }} &lt;<a href="mailto:{{ message.email }}">{{ message.email }}</a>&gt;</span>
    <span>📅 {{ message.created_at|date('d M Y H:i') }}</span>
    {% if message.ip_address %}<span>🌐 {{ message.ip_address }}</span>{% endif %}
  </div>
</div>

<div class="cf-card">
  <div class="cf-card-body cf-article-content" style="white-space:pre-wrap;">{{ message.message }}</div>
</div>

<div style="margin-top:1rem;display:flex;gap:.5rem;">
  <a href="mailto:{{ message.email }}?subject=Re: {{ message.subject|default('je bericht') }}" class="cf-btn">↩️ Beantwoorden via e-mail</a>
  <form method="post" action="/admin/contact/{{ message.id }}/verwijder" onsubmit="return confirm('Bericht definitief verwijderen?');">
    {{ csrf_field()|raw }}
    <button type="submit" class="cf-btn cf-btn-ghost">🗑️ Verwijderen</button>
  </form>
</div>

<div style="margin-top:1.5rem;">
  <a href="/admin/contact" class="cf-btn cf-btn-ghost">← Terug naar inbox</a>
</div>
{% endblock %}
