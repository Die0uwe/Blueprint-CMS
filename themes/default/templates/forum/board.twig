{% extends 'layout.twig' %}
{% block title %}{{ board.name }}{% endblock %}
{% block content %}
<div class="cf-page-header">
  <div class="cf-breadcrumb"><a href="/">Home</a> → <a href="/forum">Forum</a> → {{ board.name }}</div>
  <h1>{{ board.name }}</h1>
  {% if board.description %}<p style="color:var(--text-dim);margin-top:.3rem;">{{ board.description }}</p>{% endif %}
</div>

{% if can_post %}
<div style="margin-bottom:1rem;">
  <a href="/forum/{{ board.slug }}/nieuw" class="cf-btn">➕ Nieuw topic</a>
</div>
{% endif %}

<div class="cf-forum-topics">
  {% for topic in topics %}
  <div class="cf-card" style="margin-bottom:.6rem;">
    <div class="cf-card-body" style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <div style="flex:1;min-width:220px;">
        <h3 style="font-size:1rem;margin-bottom:.2rem;">
          {% if topic.is_pinned %}<span class="cf-badge cf-badge-gold">📌 Vastgezet</span>{% endif %}
          {% if topic.is_locked %}<span class="cf-badge cf-badge-purple">🔒 Gesloten</span>{% endif %}
          <a href="/forum/{{ board.slug }}/{{ topic.slug }}">{{ topic.title }}</a>
        </h3>
        <div style="color:var(--muted);font-size:.8rem;">
          door <a href="/leden/{{ topic.username }}" style="color:inherit;">{{ topic.display_name|default(topic.username) }}</a> · {{ topic.created_at|date('d M Y') }}
        </div>
      </div>
      <div style="text-align:center;min-width:60px;">
        <div style="font-weight:800;">{{ topic.reply_count }}</div>
        <div style="color:var(--muted);font-size:.75rem;">reacties</div>
      </div>
      <div style="text-align:center;min-width:60px;">
        <div style="font-weight:800;">{{ topic.views }}</div>
        <div style="color:var(--muted);font-size:.75rem;">views</div>
      </div>
      {% if can_moderate %}
      <div style="display:flex;gap:.3rem;flex-wrap:wrap;">
        <form method="post" action="/forum/{{ board.slug }}/{{ topic.slug }}/pin">
          {{ csrf_field()|raw }}
          <button type="submit" class="cf-btn-sm cf-btn-ghost">{{ topic.is_pinned ? 'Losmaken' : 'Pin' }}</button>
        </form>
        <form method="post" action="/forum/{{ board.slug }}/{{ topic.slug }}/lock">
          {{ csrf_field()|raw }}
          <button type="submit" class="cf-btn-sm cf-btn-ghost">{{ topic.is_locked ? 'Heropen' : 'Sluit' }}</button>
        </form>
      </div>
      {% endif %}
    </div>
  </div>
  {% else %}
  <p style="color:var(--muted);">Nog geen topics in dit bord.{% if can_post %} Wees de eerste!{% endif %}</p>
  {% endfor %}
</div>

{% if pagination.total > 1 %}
<div style="display:flex;gap:.5rem;justify-content:center;margin-top:1.5rem;">
  {% for p in 1..pagination.total %}
    <a href="/forum/{{ board.slug }}?page={{ p }}"
       class="cf-btn-sm {{ p == pagination.current ? '' : 'cf-btn-ghost' }}">{{ p }}</a>
  {% endfor %}
</div>
{% endif %}
{% endblock %}
