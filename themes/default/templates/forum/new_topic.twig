{% extends 'layout.twig' %}
{% block content %}
<div class="cf-page-header">
  <div class="cf-breadcrumb">
    <a href="/">Home</a> → <a href="/forum">Forum</a> → <a href="/forum/{{ board.slug }}">{{ board.name }}</a> → Nieuw topic
  </div>
  <h1>➕ Nieuw topic in {{ board.name }}</h1>
</div>

<div class="cf-card">
  <div class="cf-card-body">
    <form method="post" action="/forum/{{ board.slug }}/nieuw">
      {{ csrf_field()|raw }}
      <div class="cf-form-group">
        <label class="cf-label" for="title">Titel</label>
        <input type="text" id="title" name="title" class="cf-input" maxlength="255" required>
      </div>
      <div class="cf-form-group">
        <label class="cf-label" for="content">Bericht</label>
        <textarea id="content" name="content" class="cf-textarea" required></textarea>
      </div>
      <button type="submit" class="cf-btn">Topic plaatsen</button>
      <a href="/forum/{{ board.slug }}" class="cf-btn cf-btn-ghost">Annuleren</a>
    </form>
  </div>
</div>
{% endblock %}
