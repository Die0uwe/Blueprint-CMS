<!DOCTYPE html>
<html lang="{{ locale|default('nl') }}" data-theme="{{ theme_slug }}" data-default-theme="{{ theme_slug }}" data-choice="{{ (settings.visitor_theme_choice|default('1')) == '0' ? '0' : '1' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ page_title|default('') }}{% endblock %}{% if settings.site_name is defined %} — {{ settings.site_name }}{% endif %}</title>
<meta name="description" content="{% block meta_desc %}{{ settings.site_description|default('') }}{% endblock %}">
{% if settings.site_icon is defined and settings.site_icon %}
<link rel="icon" href="{{ settings.site_icon }}">
{% endif %}
<link rel="stylesheet" href="{{ asset('css/blueprint.css') }}">
{# Thema's (Golf 4): ALLE thema's staan als html[data-theme="slug"]-regels in één
   <style>; wisselen van thema of licht/donker is puur client-side (data-attributen
   op <html>). cf-theme-init.js staat bewust blokkerend in <head> zodat de keuze van
   de bezoeker vóór de eerste verf wordt toegepast (geen flits). Validatie van
   theme.json-waarden: Core\Template\ThemeCatalog. #}
<style id="cf-theme-css">{{ theme_css|raw }}</style>
<script type="application/json" id="cf-themes">{{ theme_picker|json_encode|raw }}</script>
<script src="{{ asset('js/cf-theme-init.js') }}"></script>
{% block head %}{% endblock %}
</head>
<body class="cf-theme" data-theme-slug="{{ theme.slug|default('') }}" data-theme-name="{{ theme.name|default('') }}">

{# HEADER ZONE #}
<header id="cf-header">
  <div class="cf-container">
    <a href="/" class="cf-logo-wrap">
      <span class="cf-logo-row">
        <img src="{{ asset('img/logo-64.png') }}" alt="" class="cf-logo-icon">
        <span class="cf-logo">{{ settings.site_name|default('Blueprint CMS') }}</span>
      </span>
      {% if settings.site_motd is defined and settings.site_motd %}
        <span class="cf-motd">{{ settings.site_motd }}</span>
      {% endif %}
    </a>
    <button type="button" class="cf-menu-toggle" id="cf-menu-toggle" aria-label="{{ trans('nav.menu') }}" aria-expanded="false" aria-controls="cf-header-panel">
      <span class="cf-menu-bars" aria-hidden="true"></span>
    </button>
    <div class="cf-header-panel" id="cf-header-panel">
    <nav class="cf-nav">
      <a href="/news" class="cf-nav-link">{{ trans('nav.news') }}</a>
      <a href="/blog" class="cf-nav-link">{{ trans('nav.blog') }}</a>
      <a href="/forum" class="cf-nav-link">{{ trans('nav.forum') }}</a>
      <a href="/downloads" class="cf-nav-link">{{ trans('nav.downloads') }}</a>
      {# Ontbrak hier sinds S11 (Media-galerij) — de module/routes/views
         bestonden al, maar niemand kon /galerij bereiken zonder de URL uit
         het hoofd te typen. Gevonden tijdens de S13-conversie van dit
         bestand. #}
      <a href="/galerij" class="cf-nav-link">{{ trans('nav.gallery') }}</a>
      {% for page in menu_pages %}
        <a href="/page/{{ page.slug }}" class="cf-nav-link">{{ page.title }}</a>
      {% endfor %}
      <a href="/contact" class="cf-nav-link">{{ trans('nav.contact') }}</a>
    </nav>
    <div class="cf-header-actions">
      {% if theme_picker|length > 1 %}
      <div class="cf-theme-switch" id="cf-theme-switch" hidden>
        <button type="button" class="cf-theme-btn" id="cf-theme-btn" aria-haspopup="true" aria-expanded="false" aria-label="{{ trans('nav.theme') }}">🎨</button>
        <div class="cf-theme-menu" id="cf-theme-menu" role="menu" hidden>
          <div class="cf-theme-modes" role="group">
            <button type="button" data-mode-pref="light">☀️ {{ trans('nav.light') }}</button>
            <button type="button" data-mode-pref="dark">🌙 {{ trans('nav.dark') }}</button>
          </div>
          <div class="cf-theme-list" id="cf-theme-list"></div>
        </div>
      </div>
      {% endif %}
      {# S13 (Multi-language/i18n) — publieke taalwisselaar, werkt ook voor
         gasten (sessie-override, zie LanguageController::switch()). #}
      <div class="cf-lang-switch">
        {% for l in supported_locales %}
          <a href="/taal/{{ l }}" class="{{ l == locale ? 'active' : '' }}">{{ l|upper }}</a>
        {% endfor %}
      </div>
      {% if auth.check() %}
        <a href="/admin" class="cf-btn-sm">{{ trans('nav.admin') }}</a>
        <a href="/logout" class="cf-btn-sm cf-btn-ghost">{{ trans('nav.logout') }}</a>
      {% else %}
        <a href="/login" class="cf-btn-sm">{{ trans('nav.login') }}</a>
      {% endif %}
    </div>
    </div>{# /cf-header-panel #}
  </div>
</header>

{# HEADER-ZONE BLOKKEN — #cf-header hierboven heeft een vaste hoogte (logo/nav/acties
   in één rij), dus geplaatste blokken komen in een eigen, los-hoge balk erónder i.p.v.
   erin geperst — dat voorkomt overflow van blokken met willekeurige inhoud. #}
{% if zones.header is defined and zones.header %}
<div id="cf-header-blocks" class="cf-container">
  {% for block in zones.header %}
    {{ render_block(block)|raw }}
  {% endfor %}
</div>
{% endif %}

{# TOP MENU ZONE — apart van het vaste hoofdmenu in #cf-header, zoals de
   projectblueprint Header en Top Menu als twee losse layout-onderdelen beschrijft. #}
{% if zones.topmenu is defined and zones.topmenu %}
<nav id="cf-topmenu" class="cf-container">
  {% for block in zones.topmenu %}
    {{ render_block(block)|raw }}
  {% endfor %}
</nav>
{% endif %}

{# MAIN LAYOUT #}
<div id="cf-main" class="cf-layout">

  {# LINKER SIDEBAR #}
  {% if zones.sidebar_left is defined and zones.sidebar_left %}
  <aside id="cf-sidebar-left" class="cf-sidebar">
    {% for block in zones.sidebar_left %}
      {{ render_block(block)|raw }}
    {% endfor %}
  </aside>
  {% endif %}

  {# CENTER CONTENT #}
  <main id="cf-content">
    {% block content %}{% endblock %}
  </main>

  {# RECHTER SIDEBAR #}
  {% if zones.sidebar_right is defined and zones.sidebar_right %}
  <aside id="cf-sidebar-right" class="cf-sidebar">
    {% for block in zones.sidebar_right %}
      {{ render_block(block)|raw }}
    {% endfor %}
  </aside>
  {% endif %}

</div>

{# FOOTER #}
<footer id="cf-footer">
  <div class="cf-container">
    {% if zones.footer is defined and zones.footer %}
    <div id="cf-footer-blocks">
      {% for block in zones.footer %}
        {{ render_block(block)|raw }}
      {% endfor %}
    </div>
    {% endif %}
    <p>© {{ "now"|date("Y") }} {{ settings.site_name|default('Blueprint CMS') }}</p>
    <p class="cf-footer-links">
      <a href="https://www.dieouwe.nl">DieOuwe</a> ·
      <a href="https://www.scriptspace.nl">ScriptSpace</a> ·
      <a href="https://github.com/Die0uwe/Bluprint-CMS">GitHub</a>
    </p>
  </div>
</footer>

<script src="{{ asset('js/blueprint.js') }}"></script>
<script src="{{ asset('js/cf-theme.js') }}"></script>
{% block scripts %}{% endblock %}
</body>
</html>
