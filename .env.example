# Community Fusion CMS — Environment variabelen
# Kopieer naar .env en vul in

APP_NAME="Community Fusion CMS"
APP_URL=http://localhost
APP_ENV=production
APP_DEBUG=false

# APP_KEY en JWT_SECRET worden door de web-installer automatisch gegenereerd
# in config/config.php (app.key / jwt.secret) — dat bestand is de bron van
# waarheid, niet deze .env. Vul deze twee alleen handmatig in als je zonder
# installer draait (bv. in een test/CI-omgeving). Gebruik ALTIJD twee losse,
# willekeurige waarden — nooit dezelfde sleutel voor beide:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32));"
APP_KEY=
JWT_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fusion_cms
DB_USER=root
DB_PASS=
DB_PREFIX=cf_

CACHE_DRIVER=file
SESSION_LIFETIME=7200

# De installer leest MAIL_HOST hieruit (via InstallerCore::readEnvValue(),
# geen Dotenv-dependency nodig): leeg = driver 'mail' (PHP's ingebouwde
# mail()), ingevuld = driver 'smtp' met de onderstaande instellingen. Vul
# dit dus pas in als je een echte SMTP-server hebt — anders blijft dit leeg
# zodat installaties niet stilzwijgend proberen te mailen naar een
# voorbeeld-hostnaam die niet bestaat.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME="Community Fusion"

# Golf 10 (OAuth-providers) ontdekte dat de DISCORD_*/TWITCH_*-variabelen
# hieronder NOOIT ergens door de applicatie gelezen worden — geen enkele
# OAuthController leest $_ENV voor client_id/secret. De echte, werkende
# plek om Discord, Twitch, Google en Battle.net client-ID's/secrets in te
# vullen is de admin-UI: /admin/marketplace/package/{provider}/instellingen
# (na het inschakelen van de module bij Marketplace of tijdens de installer-
# stap "Modules"). Die instellingen komen in cf_settings terecht, met
# client_secret/bot_token altijd versleuteld (AES-256-GCM, zie
# Core\Security\Crypto). Deze regels blijven hier staan als overzicht van
# wélke providers ondersteund worden, NIET als functionele configuratie —
# vul ze dus niet hier in en verwacht geen effect als je dat wel doet.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_REGION=eu

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
